# docker compose 变量。复制为 .env 后按环境修改。

IMAGE_TAG=latest
PORT=3030

# URL 的主机名是容器名。网络 backend-chat-agent 里的容器是 chat-agent，backend-site 里的容器是 site。
CHAT_API_URL=http://chat-agent:9998
SITE_API_URL=http://site:9997
# 下面两个是 Docker 网络名，不是容器名。compose 只加入已有网络，不会创建。
CHAT_AGENT_NETWORK=backend-chat-agent
SITE_NETWORK=backend-site

# 可进入 /admin 的用户名，逗号分隔，需与登录名完全一致。留空则所有账号都无法进入后台。
ADMIN_USERS=
