# docker compose 变量。复制为 .env 后按环境修改。

IMAGE_TAG=latest
PORT=3030

# 前端容器访问后端的地址。后端未启动时页面仍可起来，接口会失败。
# chat 负责对话与会话，site 负责登录与账号。
# 后端起来后分别加入对应网络，即可用服务名访问：
#   docker network connect chat-agent_default chat-agent
#   docker network connect site_default site
CHAT_API_URL=
SITE_API_URL=
CHAT_AGENT_NETWORK=
SITE_NETWORK=

# 可进入 /admin 的用户名，逗号分隔，需与登录名完全一致。留空则所有账号都无法进入后台。
ADMIN_USERS=
